# Needed for "Describe a change" (the AI edits). Everything else works without it.
ANTHROPIC_API_KEY=

PORT=3010

# Optional: only if you want "Publish to store" to write the change into a real
# theme. Use a store you own (a dev store is ideal). Make a custom app in that
# store's admin (Settings > Apps > Develop apps) with the read_themes and
# write_themes scopes, install it, and paste the Admin API token here.
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# Optional: the storefront password, if the store above still has one
# (every new dev store does). Lets the preview get past the password page.
STOREFRONT_PASSWORD=
